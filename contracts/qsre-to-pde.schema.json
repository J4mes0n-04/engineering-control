{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://engineering-control.local/contracts/qsre-to-pde.schema.json",
  "title": "QSRE to PDE feedback contract v1.0.0",
  "type": "object",
  "required": ["schema_version", "contract_type", "contract_version", "feedback_id", "created_at", "outcome_id", "pack", "implementation", "feedback_type", "severity", "observation", "affected_identifiers", "evidence", "required_decision", "qsre_owner", "pde_response"],
  "properties": {
    "schema_version": {"const": 1},
    "contract_type": {"const": "qsre-to-pde"},
    "contract_version": {"const": "1.0.0"},
    "feedback_id": {"type": "string", "pattern": "^QF-[A-Z0-9-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "outcome_id": {"type": "string", "pattern": "^OUT-[A-Z0-9-]+$"},
    "pack": {"$ref": "#/definitions/versionedReference"},
    "implementation": {"$ref": "#/definitions/immutableReference"},
    "feedback_type": {"enum": ["clarification", "definition-change", "defect", "governance-signal"]},
    "severity": {"enum": ["critical", "major", "minor", "info"]},
    "observation": {
      "type": "object", "required": ["summary", "observed_at", "environment"],
      "properties": {
        "summary": {"type": "string", "minLength": 20},
        "observed_at": {"type": "string", "format": "date-time"},
        "environment": {"type": "string", "minLength": 2}
      },
      "additionalProperties": false
    },
    "affected_identifiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(AC|NFR|SLICE|RISK|CON|PR|REL|PDE-GOV)-[A-Z0-9-]+$"}},
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["evidence_id", "reference", "summary"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^EVD-[0-9]{3,}$"},
          "reference": {"$ref": "#/definitions/immutableReference"},
          "summary": {"type": "string", "minLength": 10}
        },
        "additionalProperties": false
      }
    },
    "required_decision": {
      "type": "object", "required": ["summary", "due_at", "release_impact"],
      "properties": {
        "summary": {"type": "string", "minLength": 10},
        "due_at": {"type": "string", "format": "date-time"},
        "release_impact": {"enum": ["none", "hold", "rollback", "rework", "review-required"]}
      },
      "additionalProperties": false
    },
    "qsre_owner": {"type": "string", "minLength": 2},
    "pde_response": {
      "type": "object", "required": ["status"],
      "properties": {
        "status": {"enum": ["pending", "accepted", "rejected", "resolved"]},
        "responded_by": {"type": "string", "minLength": 2},
        "responded_at": {"type": "string", "format": "date-time"},
        "decision": {"type": "string", "minLength": 10},
        "linked_action_id": {"type": "string", "pattern": "^(DC|DEFECT|RFC)-[A-Z0-9-]+$"},
        "closure_evidence": {"$ref": "#/definitions/immutableReference"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"enum": ["accepted", "rejected", "resolved"]}}, "required": ["status"]}, "then": {"required": ["responded_by", "responded_at", "decision", "linked_action_id"]}},
        {"if": {"properties": {"status": {"const": "resolved"}}, "required": ["status"]}, "then": {"required": ["closure_evidence"]}}
      ],
      "additionalProperties": false
    }
  },
  "definitions": {
    "immutableReference": {
      "type": "object", "required": ["repository", "commit_sha", "path"],
      "properties": {"repository": {"type": "string", "format": "uri"}, "commit_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}, "path": {"type": "string", "minLength": 3}},
      "additionalProperties": false
    },
    "versionedReference": {
      "type": "object", "required": ["repository", "commit_sha", "path", "version"],
      "properties": {
        "repository": {"type": "string", "format": "uri"},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "path": {"type": "string", "minLength": 3},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
